  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:suite": "node scripts/run-suite.js",
    "test:login": "playwright test --project=01-login --headed --workers=1 --no-deps",
    "test:allocation": "playwright test --project=02-allocation --headed --workers=1 --no-deps",
    "test:remote-login": "playwright test --project=03-remote-login --headed --workers=1 --no-deps",
