    "test:probation": "playwright test --project=08-probation --headed --workers=1 --no-deps",
    "test:probation-from-07": "playwright test --project=08-probation --headed --workers=1 --no-deps -g \"HR Reject and Extend from Rejected\"",
    "test:probation-from-11": "playwright test --project=08-probation --headed --workers=1 --no-deps -g \"11. HR Process Extend|12. Verify Extended|13. Raise probation|14. RM Confirm|15. Verify Approved status and confirm|16. HR Process probation\"",
    "test:probation-from-12": "playwright test --project=08-probation --headed --workers=1 --no-deps -g \"12. Verify Extended|13. Raise probation|14. RM Confirm|15. Verify Approved status and confirm|16. HR Process probation\"",
    "test:probation-from-14": "playwright test --project=08-probation --headed --workers=1 --no-deps -g \"14. RM Confirm|15. Verify Approved status and confirm|16. HR Process probation\"",
    "test:probation-from-17": "playwright test --project=08-probation --headed --workers=1 --no-deps -g \"Generate Document and Move to Active\"",
    "test:probation-extend": "playwright test --project=08-probation --headed --workers=1 --no-deps -g \"HR Reject and Extend from Rejected\"",
    "test:personalization": "playwright test --project=06-personalization --headed --workers=1 --no-deps",
    "test:headed": "playwright test --headed --workers=1 --no-deps",
    "test:holidays": "playwright test --project=06-holidays --headed --workers=1 --no-deps",
    "test:codegen-holidays": "playwright test --project=07-codegen-holidays --headed --workers=1 --no-deps",
    "test:leave-category": "playwright test --project=11-leave-category --headed --workers=1 --no-deps",
